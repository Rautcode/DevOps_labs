# syntax=docker/dockerfile:1
# Build context: repo root  ->  docker build -f 02-containers/Dockerfile.web -t devlab-web:lab .
# Static site served by unprivileged nginx (runs as non-root on :8080).
FROM nginxinc/nginx-unprivileged:stable-alpine
# Patch OS packages that upstream has not rebuilt yet (Trivy flagged fixable HIGH/CRITICAL CVEs)
USER 0
RUN apk upgrade --no-cache
USER 101
COPY 02-containers/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY app/web /usr/share/nginx/html
ENV API_UPSTREAM=api:5000 NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s CMD ["wget", "-qO-", "http://127.0.0.1:8080/nginx-health"]
