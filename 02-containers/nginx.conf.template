# ${API_UPSTREAM} is substituted at container start (envsubst), so the same image
# works in compose (api:5000) and Kubernetes (devlab-api:5000).
server {
  listen 8080;
  root /usr/share/nginx/html;

  # Security headers (a subset of vercel.json).
  # GOTCHA: nginx does NOT merge add_header across levels. If a location block has its own add_header, it REPLACES
  # the ones set at server level. So the three security headers are repeated in every location that sets a header.
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Resolve the API at request time (not at startup) so nginx boots even if the API is
  # not ready yet, and picks up new pod IPs. NGINX_LOCAL_RESOLVERS is set by the image.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
  set $api http://${API_UPSTREAM};

  location = /nginx-health { access_log off; return 200 "ok\n"; }

  location /api/ {
    proxy_pass $api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 12m;
  }
  location = /healthz { proxy_pass $api; }
  location = /readyz  { proxy_pass $api; }

  # Hashed build assets: cache forever. Everything else: SPA fallback, never cached.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    try_files $uri =404;
  }
  location / {
    add_header Cache-Control "no-store";
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    try_files $uri /index.html;
  }
}
