# syntax=docker/dockerfile:1
# Build context: app/api   ->  docker build -f 02-containers/Dockerfile.api -t devlab-api:lab app/api

# --- deps: production dependencies only, cached unless package*.json changes
FROM node:24-slim AS deps
WORKDIR /app
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev

# --- runtime
FROM node:24-slim
ENV NODE_ENV=production DATA_DIR=/data PORT=5000
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# The runtime needs no package manager. Removing npm/corepack drops their bundled (often outdated) dependencies
# from the image: Trivy flagged HIGH CVEs inside them, not in our code.
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
# Writable data dir owned by the unprivileged user (SQLite db lives here)
RUN mkdir /data && chown node:node /data
USER 1000:1000
VOLUME /data
EXPOSE 5000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://localhost:5000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "server.js"]
